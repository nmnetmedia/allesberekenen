---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../islands/Search';
import CalculatorCard from '../components/CalculatorCard.astro';
import { popularCalculators, searchIndex } from '../data/calculators';
---
<BaseLayout title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer). Zoek een calculator of kies een van de populaire calculators." path="/404" noindex>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Fout 404</p>
      <h1 style="font-size:clamp(2rem,1.5rem + 2vw,3rem);margin-top:8px">Deze pagina bestaat niet</h1>
      <p class="hero-sub">Misschien is de link verouderd of zit er een typfout in. Zoek hieronder de calculator die je nodig hebt.</p>
      <Search client:load items={searchIndex} variant="hero" />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Populaire calculators</h2><a href="/calculators">Alle calculators →</a></div>
      <div class="card-grid">{popularCalculators().map((c) => <CalculatorCard calc={c} />)}</div>
    </div>
  </section>
</BaseLayout>
